# Copia este archivo como .env y ajusta los valores.
# El .env esta ignorado por git: nunca subas credenciales reales al repositorio.

# ===== Base de datos =====
DB_USER=postgres
# Obligatoria. Sin valor por defecto: docker compose falla si no la defines.
DB_PASSWORD=your_secure_password_here
DB_NAME=presente
DB_PORT=5432

# URL completa de conexion. El backend la exige al arrancar (app/config.py).
# LOCAL (sin Docker):  postgresql://postgres:tu_clave@localhost:5432/presente
# DOCKER:              la construye docker-compose a partir de las variables de arriba
# PRODUCTION (Render): la entrega Render como Internal Database URL
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/presente

# ===== Puertos de los servicios =====
BACKEND_PORT=8000
FRONTEND_PORT=80

# ===== URLs =====
ENV=development
API_BASE_URL=http://localhost:8000

# URL del backend que usara el navegador. La lee entrypoint.sh para generar
# el config.json que consume el frontend en produccion.
# LOCAL / DOCKER:      http://localhost:8000
# PRODUCTION (Render): https://presente-backend-<sufijo>.onrender.com
BACKEND_URL=http://localhost:8000

# URL base del frontend, usada para construir la URL que codifica el QR.
# El backend la exige al arrancar: si apunta al sitio equivocado, el QR
# lleva a los estudiantes a otra parte.
# LOCAL:                http://localhost:5173
# DEV TUNNEL (VS Code): https://<id>-5173.<region>.devtunnels.ms
# PRODUCTION (Render):  https://presente-frontend-<sufijo>.onrender.com
FRONTEND_BASE_URL=http://localhost:5173

# ===== CORS (backend) =====
# Origenes exactos autorizados, separados por comas.
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1:5173

# Patron opcional para autorizar familias de dominios completas.
# Dejalo vacio si solo necesitas los origenes exactos de arriba.
# Para Render y los dev tunnels de VS Code:
#   https?://.*\.onrender\.com|https://.*\.devtunnels\.ms
ALLOWED_ORIGIN_REGEX=

# ===== JWT/Security (si se necesita en el futuro) =====
# SECRET_KEY=your_secret_key_here
# ALGORITHM=HS256

# ===== Email (si se necesita en el futuro) =====
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SENDER_EMAIL=your_email@gmail.com
# SENDER_PASSWORD=your_app_password
