# Configuracion del frontend en desarrollo (Vite).
# Copia este archivo como .env.local y ajusta el valor.
# .env.local esta ignorado por git.
#
# Solo aplica al servidor de desarrollo (npm run dev). En produccion la URL
# llega en runtime por el config.json que genera entrypoint.sh en el contenedor.
#
# Vite solo expone al navegador las variables que empiezan por VITE_.

# URL del backend contra el que trabaja el frontend.
# LOCAL:                http://localhost:8000
# DEV TUNNEL (VS Code): https://<id>-8000.<region>.devtunnels.ms
VITE_API_BASE_URL=http://localhost:8000
